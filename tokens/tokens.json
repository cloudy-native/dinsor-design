{
  "$description": "Single source of truth. Edit here, run `npm run build`. CSS variable = --<name> for color, font and size groups; --radius-<name>; --space-<name>.",
  "color": {
    "bg":              { "value": "#F5F4ED", "use": "page background. Never #fff, never cool gray" },
    "surface":         { "value": "#FAF9F5", "use": "cards, code blocks, inputs, elevated paper" },
    "sand":            { "value": "#E8E6DC", "use": "secondary buttons, interactive fills" },
    "ink":             { "value": "#141413", "use": "primary text and focus ring. Not pure black" },
    "ink-soft":        { "value": "#3D3D3A", "use": "secondary text" },
    "olive":           { "value": "#504E49", "use": "quotes, captions, de-emphasized text" },
    "stone":           { "value": "#6B6A64", "use": "footnotes, meta" },
    "line":            { "value": "#D9D6CC", "use": "the one hairline, only when a boundary must be explicit" },
    "accent":          { "value": "#1C3D32", "use": "links, one primary button, overlines, key numbers" },
    "accent-ink":      { "value": "#FAF9F5", "use": "text on accent. Ivory, not pure white" },
    "accent-hover":    { "value": "#143028", "use": "primary button hover. Darken, never brighten" },
    "tag-quiet":       { "value": "#E7EFE9", "use": "receding tag fill" },
    "tag":             { "value": "#D9E6DE", "use": "default tag fill" },
    "danger":          { "value": "#B53333", "use": "errors only. Not a brand color" },
    "dark":            { "value": "#141413", "use": "dark band base. Only when a brief asks" },
    "dark-surface":    { "value": "#30302E", "use": "containers on dark" },
    "accent-on-dark":  { "value": "#8FBFAB", "use": "links and labels on dark" }
  },
  "font": {
    "serif": { "value": "\"Source Serif 4\", \"Iowan Old Style\", Palatino, \"Palatino Linotype\", serif", "use": "display only: headlines, big numbers, pull quotes. Weight 500, never higher" },
    "sans":  { "value": "\"Source Sans 3\", \"Avenir Next\", \"Segoe UI\", sans-serif", "use": "body, nav, buttons, captions, labels. Weight 400, labels 500" },
    "mono":  { "value": "\"JetBrains Mono\", ui-monospace, monospace", "use": "code, hex, versions" }
  },
  "size": {
    "display": { "value": "48px", "use": "serif, lh 1.10. 36px under 768px" },
    "h1":      { "value": "32px", "use": "serif, lh 1.20" },
    "h2":      { "value": "22px", "use": "serif, lh 1.25. Also pull quote" },
    "h3":      { "value": "18px", "use": "serif, lh 1.30" },
    "metric":  { "value": "32px", "use": "serif, lh 1.10, accent. Big numbers" },
    "body":    { "value": "17px", "use": "sans, lh 1.60" },
    "control": { "value": "16px", "use": "buttons" },
    "caption": { "value": "14px", "use": "sans, lh 1.45. Tags, code, errors" },
    "label":   { "value": "12px", "use": "sans 500, lh 1.35, tracking 0.06em" },
    "display-mobile": { "value": "36px", "use": "display under 768px" }
  },
  "radius": {
    "chip":    { "value": "2px", "use": "tags" },
    "control": { "value": "4px", "use": "buttons, inputs, code" },
    "card":    { "value": "8px", "use": "cards" }
  },
  "space": {
    "4":  { "value": "4px",  "use": "tag padding, inline gaps" },
    "8":  { "value": "8px",  "use": "tag padding, inline gaps" },
    "12": { "value": "12px", "use": "inside a component" },
    "16": { "value": "16px", "use": "inside a component" },
    "24": { "value": "24px", "use": "between components, card padding" },
    "32": { "value": "32px", "use": "between components" },
    "48": { "value": "48px", "use": "under a section title" },
    "64": { "value": "64px", "use": "under a section title" },
    "96": { "value": "96px", "use": "between major sections" }
  },
  "shadow": {
    "floating": { "value": "0 8px 24px rgba(20, 20, 19, 0.08)", "use": "menu, dialog only. Nothing else gets a shadow" }
  },
  "layout": {
    "max-width":    { "value": "1040px", "use": "content width" },
    "measure":      { "value": "66ch",   "use": "prose width" },
    "page-padding": { "value": "20px",   "use": "under 768px. 32px from 768 up" },
    "hit-target":   { "value": "44px",   "use": "minimum control height" }
  },
  "themes": {
    "$description": "Accent variants. Set <html data-theme=\"name\">. Hover, tags and on-dark are derived from the accent by scripts/build.mjs. Emerald is the default and needs no attribute.",
    "emerald":  { "value": "#1C3D32", "use": "default. Deep green" },
    "garnet":   { "value": "#6B1E2E", "use": "wine red" },
    "amethyst": { "value": "#4B2A63", "use": "deep violet" },
    "peacock":  { "value": "#134B52", "use": "blue-green" },
    "topaz":    { "value": "#6E430C", "use": "bronze amber" }
  }
}
